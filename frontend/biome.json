{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/.next", "!next-env.d.ts", "!**/node_modules", "!**/storybook-static"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/*",
                      "@/app/*",
                      "@tanstack/react-query",
                      "next/navigation",
                      "next/router"
                    ],
                    "message": "shared/ui must stay portable and Props-driven."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/*",
                      "@/app/*",
                      "@ui-sdk/*",
                      "@tanstack/react-query",
                      "next/navigation",
                      "next/router"
                    ],
                    "message": "shared/components must compose shared/ui only and stay Props-driven."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**", "src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ui-sdk/*", "@tanstack/react-query"],
                    "message": "Import UI primitives from @/shared/ui and query helpers from @/shared/lib."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
